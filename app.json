{
  "expo": {
    "name": "FitBalance",
    "slug": "FitBalance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/FitBalanceLogo.jpg",
    "splash": {
      "image": "./assets/FitBalanceLogo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-activity-recognition",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a FitBalance acceder a la cámara",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "21.4.7075529",
            "cmakeVersion": "3.18.1",
            "kotlin": {
              "version": "1.8.10"
            }
          }
        }
      ],
      "expo-localization"
    ],
    "android": {
      "package": "com.fitbalance",
      "adaptiveIcon": {
        "foregroundImage": "./assets/FitBalanceLogo.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "runtimeVersion": "1.0.1",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.ayasc.nutifrut",
      "supportsTablet": true,
      "infoPlist": {},
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/FitBalanceLogo.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "82f4234e-cbbc-4e4d-9b39-7ff1b567c9ff"
      }
    },
    "owner": "ayasc",
    "updates": {
      "url": "https://u.expo.dev/82f4234e-cbbc-4e4d-9b39-7ff1b567c9ff"
    }
  }
}
